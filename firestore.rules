rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function general() { return signedIn() && profile().activo == true && profile().rol == 'superadmin'; }
    function member(id) { return signedIn() && profile().activo == true && profile().empresaId == id; }
    function validCompany() { return request.resource.data.keys().hasOnly(['nombre', 'activa', 'demo']) && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100 && request.resource.data.activa is bool && request.resource.data.get('demo', false) is bool; }
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || general());
      allow list: if general();
      // Superadmins manage company users, never another superadmin (that is done from the console).
      allow create, update: if general() && uid != request.auth.uid
        && (resource == null || resource.data.rol != 'superadmin')
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'empresaId', 'rol', 'activo'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && request.resource.data.activo is bool
        && request.resource.data.rol in ['admin', 'vendedor']
        && request.resource.data.empresaId is string
        && exists(/databases/$(database)/documents/empresas/$(request.resource.data.empresaId));
      allow delete: if general() && uid != request.auth.uid && resource.data.rol != 'superadmin';
    }
    match /empresas/{id} {
      allow get: if general() || member(id);
      allow list: if general();
      allow create: if general() && validCompany();
      // A company is created as demo or real and can never switch: real data must not mix with demo resets.
      allow update: if general() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'activa'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100 && request.resource.data.activa is bool;
    }
    // Only the display name and access status are public; directory listing is forbidden.
    match /accesos/{id} {
      allow get: if true;
      allow list: if general();
      allow create, update: if general() && validCompany();
    }
    // Business data: empresas/{empresaId}/{coleccion}/{docId}.
    // The superadmin (support mode) and the company admin manage the business;
    // a vendedor can sell and collect but cannot change prices, credit or config.
    // Sales, credit notes and payments are written only by the server
    // (/api/operaciones), which prices them from the catalog and checks permissions.
    // The browser writes them only when resetting a demo company.
    // Data is only ever deleted in demo companies (demo reset): real records are kept.
    match /empresas/{empresaId} {
      function active() { return get(/databases/$(database)/documents/empresas/$(empresaId)).data.activa == true; }
      function ready() { return get(/databases/$(database)/documents/empresas/$(empresaId)).data.get('restaurando', false) == false; }
      function staff() { return ready() && (general() || (member(empresaId) && active())); }
      function admin() { return ready() && (general() || (member(empresaId) && active() && profile().rol == 'admin')); }
      function disponible() { return !exists(/databases/$(database)/documents/empresas/$(empresaId)/control/escritura)
        || get(/databases/$(database)/documents/empresas/$(empresaId)/control/escritura).data.get('id', null) == null; }
      match /control/cambios { allow read: if staff(); }

      function demo() { return get(/databases/$(database)/documents/empresas/$(empresaId)).data.get('demo', false) == true; }
      function wipe() { return admin() && demo(); }
      // Costs and margins live in costos/ and ventasCostos/, readable only by admins.
      function noCosts() { return !request.resource.data.keys().hasAny(['costo', 'margen']); }
      // Credit terms and status of a customer are decided only by an admin.
      function noCredit() {
        return request.resource.data.cuentaCorriente == false && request.resource.data.limiteCredito == 0
          && request.resource.data.plazoDias == 0 && request.resource.data.estado == 'habilitado';
      }
      function creditUntouched() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['cuentaCorriente', 'limiteCredito', 'plazoDias', 'estado']);
      }

      // certificadoArca is written only by the server when a certificate is uploaded.
      function certificateUntouched() {
        return request.resource.data.get('certificadoArca', null)
          == (resource == null ? null : resource.data.get('certificadoArca', null));
      }
      match /config/{id} {
        allow read: if staff();
        allow create, update: if admin() && disponible() && (demo() || certificateUntouched());
        allow delete: if wipe();
      }
      match /categorias/{id} {
        allow read: if staff();
        allow create, update: if admin() && disponible();
        allow delete: if wipe();
      }
      match /articulos/{id} {
        allow read: if staff();
        // Stock moves with sales, which the server registers.
        allow create: if admin() && disponible() && noCosts();
        allow update: if admin() && disponible() && noCosts() && request.resource.data.stock == resource.data.stock;
        allow delete: if wipe();
      }
      match /costos/{id} {
        allow read: if admin();
        allow create, update: if admin() && disponible();
        allow delete: if wipe();
      }
      match /clientes/{id} {
        allow read: if staff();
        allow create: if disponible() && (admin() || (staff() && noCredit()));
        allow update: if disponible() && (admin() || (staff() && creditUntouched()));
        allow delete: if wipe();
      }
      match /enEspera/{id} {
        allow read, write: if staff();
      }
      // Written by the server; the browser only reloads them in a demo reset.
      match /ventas/{id} {
        allow read: if staff();
        allow create, delete: if wipe();
      }
      match /ventasCostos/{id} {
        allow read: if admin();
        allow create, delete: if wipe();
      }
      match /movimientos/{id} {
        allow read: if staff();
        allow create, delete: if wipe();
      }
      match /recibos/{id} {
        allow read: if staff();
        allow create, delete: if wipe();
      }
      match /contadores/{id} {
        allow read: if staff();
        allow create, update, delete: if wipe();
      }
      // operaciones/ (server trace of each sale and its CAE) has no rule: server-only.
    }

    // Everything else, including arcaCredenciales (ARCA private keys), is server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
