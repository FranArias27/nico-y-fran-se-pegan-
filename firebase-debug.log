[debug] [2026-10-22T15:17:07.991Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/eltornillo-6af7d/rulesets {"name":"projects/eltornillo-6af7d/rulesets/ed9ba4bf-425f-4aa7-be7d-aa4c65716e1b","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }\n    function general() { return signedIn() && profile().activo == true && profile().rol == 'superadmin'; }\n    function member(id) { return signedIn() && profile().activo == true && profile().empresaId == id; }\n    function validCompany() { return request.resource.data.keys().hasOnly(['nombre', 'activa']) && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100 && request.resource.data.activa is bool; }\n    match /usuarios/{uid} {\n      allow get: if signedIn() && (request.auth.uid == uid || general());\n      allow list: if general();\n      allow create, update: if general() && uid != request.auth.uid\n        && request.resource.data.keys().hasOnly(['nombre', 'empresaId', 'rol', 'activo'])\n        && request.resource.data.nombre is string\n        && request.resource.data.activo is bool\n        && request.resource.data.rol in ['admin', 'vendedor']\n        && request.resource.data.empresaId is string\n        && exists(/databases/$(database)/documents/empresas/$(request.resource.data.empresaId));\n      allow delete: if general() && uid != request.auth.uid && resource.data.rol != 'superadmin';\n    }\n    match /empresas/{id} {\n      allow get: if general() || member(id);\n      allow list: if general();\n      allow create, update: if general() && validCompany();\n    }\n    // Only the display name and access status are public; directory listing is forbidden.\n    match /accesos/{id} {\n      allow get: if true;\n      allow list: if general();\n      allow create, update: if general() && validCompany();\n    }\n    // Business data is still local. All other cloud access is denied until its migration.\n    match /{document=**} { allow read, write: if false; }\n  }\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-22T15:17:03.169855Z","metadata":{"services":["cloud.firestore"]}}
